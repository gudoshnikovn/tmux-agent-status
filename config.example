# tmux-agent-status config file.
#
# Copy to ~/.config/tmux-agent-status/config (or point
# $TMUX_AGENT_STATUS_CONFIG at another path) and uncomment what you want
# to change. Anything left commented keeps its built-in default.
#
# Equivalent to `set -g @agent_status_<key> <value>` in .tmux.conf - an
# explicit `set -g` always wins over this file, regardless of which one
# loads first. Use whichever is more convenient; both work together.

# prefix + j by default
# pick_key = j

# prefix + J by default: jump to the next pane that needs you
# next_key = J

# process names shown in the picker as "no hooks" when they haven't reported
# agents = claude codex gemini kimi opencode hermes aider cursor-agent copilot droid qwen grok pi amp

# picker popup size (columns/rows or %), and the preview's share of its height
# popup_width = 100%
# popup_height = 100%
# preview_size = 75%

# minutes before a finished pane you never visited goes idle anyway; 0 = never
# idle_after = 1440

# status-right "⏳2 ⚙️1 ✅3" counter - "off" to disable
# summary = on
# counter prefixes; plain text only here ('#' starts a comment) - use
# `set -g` in .tmux.conf for #[fg=...] styled icons
# summary_icon_waiting = ⏳
# summary_icon_working = ⚙️
# summary_icon_done = ✅

# transient tmux popup on waiting/done transitions - "off" to disable
# notify = on
# notify_duration = 3000

# macOS notification-center alert - "off" to disable (on by default if osascript exists)
# notify_system = on

# sound on waiting/done transitions - opt in, off by default
# notify_sound = off
# notify_sound_file = /System/Library/Sounds/Glass.aiff

# how agent-status.sh reaches the real tmux server - "file" for an
# agent running in a container/VM/remote host that can't reach the
# tmux socket directly (see README's "Agent running in a
# container/VM/remote host" section). In that scenario these two
# normally need to be set as env vars *inside the container* instead
# of here, since the container doesn't read this host config file.
# transport = direct
# bridge_file = ~/.cache/tmux-agent-status/bridge-file
